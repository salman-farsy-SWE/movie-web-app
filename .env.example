# TMDB API Credentials (Required)
# Get your API Read Access Token or API Key (v3 auth) from: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_API_KEY=your_tmdb_api_key_v3_here

# Public App URL (Used for SEO metadata, OpenGraph, sitemap, robots.txt, and OAuth redirect callbacks)
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
